{
  "manifest_version": 2,
  "name": "Сохрани видео",
  "version": "2.0.3",
  "description": "Скачивание видео с YouTube до 4K со звуком, отрывков, кадров и обложек. Работает без сторонних программ.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ytdl-bedcceec@firefox-addon",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "permissions": [
    "downloads",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://i.ytimg.com/*"
  ],
  "background": { "scripts": ["lib/mp4.js", "lib/webm.js", "lib/youtube.js", "background.js"] },
  "browser_action": {
    "default_title": "Сохрани видео",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["common.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
